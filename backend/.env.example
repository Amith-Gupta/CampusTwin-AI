# ==========================================
# CampusTwin AI - Backend Configuration
# ==========================================

PORT=5000
FLASK_ENV=production
SECRET_KEY=campustwin-secure-production-key-change-me

# Relational Database
DATABASE_URL=sqlite:///campustwin.db
# DATABASE_URL=postgresql://username:password@hostname:5432/campustwin

# Computer Vision
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45

# ML & Anomaly Detection
ANOMALY_CONTAMINATION=0.05
FORECAST_HORIZON_HOURS=24

# CORS
CORS_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app

