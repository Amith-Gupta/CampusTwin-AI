# ==========================================
# CampusTwin AI - Environment Configuration
# ==========================================

# Flask Server
PORT=5000
FLASK_ENV=production
# In Render: leave SECRET_KEY unset or set generateValue: true so Render creates a cryptographically secure random key
SECRET_KEY=campustwin-secure-production-key-change-me

# Relational Database
# For Local Development / Ephemeral Storage:
DATABASE_URL=sqlite:///campustwin.db
# For Persistent Production Cloud PostgreSQL (Render PostgreSQL / Neon / Supabase):
# DATABASE_URL=postgresql://username:password@hostname:5432/campustwin

# Computer Vision (Ultralytics YOLOv8)
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45

# Machine Learning & Anomaly Tuning
ANOMALY_CONTAMINATION=0.05
FORECAST_HORIZON_HOURS=24

# CORS Security (Comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,https://frontend-pied-ten-13.vercel.app,https://amith-gupta.github.io

# Frontend Environment Variable (Set in Vercel project environment variables)
# VITE_API_BASE_URL=https://campustwin-ai-api-rnxr.onrender.com
