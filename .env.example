# ==========================================
# CampusTwin AI - Environment Configuration
# ==========================================

# Flask Server
PORT=5000
FLASK_ENV=production
SECRET_KEY=campustwin-secure-production-key-change-me

# Relational Database
# For Local Development / Persistent Volume:
DATABASE_URL=sqlite:///campustwin.db
# For Production Cloud PostgreSQL:
# DATABASE_URL=postgresql://username:password@hostname:5432/campustwin

# Computer Vision (Ultralytics YOLOv8)
YOLO_MODEL_NAME=yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45

# Machine Learning & Anomaly Tuning
ANOMALY_CONTAMINATION=0.05
FORECAST_HORIZON_HOURS=24

# CORS Security (Comma-separated allowed domains)
CORS_ORIGINS=http://localhost:5173,https://your-frontend-deployment.vercel.app

# Frontend Environment Variable (Set in frontend hosting e.g. Vercel/Netlify)
# VITE_API_BASE_URL=https://your-backend-api.onrender.com
